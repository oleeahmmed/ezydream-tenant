DJANGO_ENV=development
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# django-tenants: SQLite দিয়ে এই প্রজেক্টের migrate করা যায় না — PostgreSQL + নিচের ENGINE লাগবে
DB_ENGINE=django_tenants.postgresql_backend
DB_NAME=ezydream_erp
DB_USER=ezydream_user
DB_PASSWORD=your-strong-password-here
DB_HOST=127.0.0.1
DB_PORT=5432

TIME_ZONE=Asia/Dhaka

# UAT: auto journal posting — use existing OACT AcctCode (Postable=Y) for each role
# FINANCE_GL_AR=
# FINANCE_GL_SALES_REVENUE=
# FINANCE_GL_AP=
# FINANCE_GL_PURCHASE_EXPENSE=
# FINANCE_GL_CASH=
# Optional when invoice/AP has tax:
# FINANCE_GL_OUTPUT_VAT=
# FINANCE_GL_INPUT_VAT=
